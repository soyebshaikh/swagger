<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:camel="http://camel.apache.org/schema/spring"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
           http://camel.apache.org/schema/spring http://camel.apache.org/schema/spring/camel-spring.xsd">

    <!-- Camel Context -->
    <camelContext id="bankingCamelContext" xmlns="http://camel.apache.org/schema/spring">
        <!-- Reference Spring Bean RouteBuilder -->
        <routeBuilder ref="bankingCamelRoutes"/>

        <!-- XML Route: Transaction Event Audit Processor -->
        <route id="transactionAuditRoute">
            <from uri="direct:auditTransaction"/>
            <log message="[CAMEL AUDIT LOG] Transaction Reference: ${body.transactionReference}, Account: ${body.accountId}, Amount: ${body.amount}, Type: ${body.transactionType}"/>
            <choice>
                <when>
                    <simple>${body.amount} &gt; 10000</simple>
                    <log message="[HIGH VALUE ALERT] Transaction ${body.transactionReference} exceeds \$10,000 threshold! Sent to Compliance."/>
                </when>
            </choice>
        </route>

        <!-- XML Route: Loan Application Review Pipeline -->
        <route id="loanReviewRoute">
            <from uri="direct:reviewLoan"/>
            <log message="[CAMEL LOAN REVIEW] Evaluating Loan Application Number: ${body.loanNumber} for User: ${body.userId}"/>
            <bean ref="loanService" method="evaluateLoanEligibility"/>
        </route>
    </camelContext>

</beans>
